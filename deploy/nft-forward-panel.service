[Unit]
Description=nftables Port Forwarding Web Panel
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nft-forward-panel
EnvironmentFile=/etc/nft-forward-panel.env
# The launcher reads PANEL_BIND, so the same unit works for the HTTPS
# (127.0.0.1 behind Caddy) and HTTP (public port) access modes.
ExecStart=/bin/bash /opt/nft-forward-panel/deploy/serve.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nftables.d /etc/nftables.conf /etc/sysctl.d /var/lib/nft-forward-panel

[Install]
WantedBy=multi-user.target
