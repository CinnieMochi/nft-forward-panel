# Required on first start. Generate with: openssl rand -hex 32
PANEL_SECRET_KEY=replace-with-a-long-random-secret

# Required only when the database has no users yet.
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional paths. Defaults are appropriate for a Linux server.
PANEL_DATA_DIR=/var/lib/nft-forward-panel
PANEL_FORWARD_CONFIG=/etc/nftables.d/port-forward.conf
PANEL_MAIN_CONFIG=/etc/nftables.conf
PANEL_SYSCTL_CONFIG=/etc/sysctl.d/99-nft-forward.conf

# Set to 1 when the panel is behind HTTPS.
PANEL_COOKIE_SECURE=1
