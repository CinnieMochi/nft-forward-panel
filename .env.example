# /etc/nft-forward-panel.env  —  systemd EnvironmentFile format.
# Written by install.sh with mode 0600; edit and `systemctl restart nft-forward-panel`.

# --- Required -------------------------------------------------------------
# Signing key for session cookies. Generate with: openssl rand -hex 32
PANEL_SECRET_KEY=replace-with-a-long-random-secret

# --- First start only -----------------------------------------------------
# Used to create the bootstrap administrator while the database has no users.
# After the first successful start, delete PANEL_ADMIN_PASSWORD from this file:
# it is never read again.
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Paths (defaults match a Debian/Ubuntu install) -----------------------
PANEL_DATA_DIR=/var/lib/nft-forward-panel
PANEL_FORWARD_CONFIG=/etc/nftables.d/port-forward.conf
PANEL_MAIN_CONFIG=/etc/nftables.conf
PANEL_SYSCTL_CONFIG=/etc/sysctl.d/99-nft-forward.conf

# --- Reverse proxy and cookies --------------------------------------------
# Set to 1 only when the panel is reachable over HTTPS.
PANEL_COOKIE_SECURE=1
# gunicorn bind address. Domain+HTTPS mode: 127.0.0.1:8108 (Caddy in front).
# IP+port HTTP mode: 0.0.0.0:<port>. Read by deploy/serve.sh.
PANEL_BIND=127.0.0.1:8108
# Number of trusted proxy hops (1 behind a single Caddy/Nginx). 0 disables
# X-Forwarded-* handling entirely; do not raise it unless you really are behind
# that many proxies.
PANEL_TRUSTED_PROXY_COUNT=1

# --- Behaviour ------------------------------------------------------------
# 0 disables the 2-second rule/quota reconciliation thread (not recommended:
# quotas, expiry and port-range limits would stop being enforced).
PANEL_POLICY_SCHEDULER=1
# Failed sign-ins allowed per source address inside the window below.
PANEL_LOGIN_WINDOW_SECONDS=600
PANEL_LOGIN_MAX_ATTEMPTS=20
# IANA zone used for monthly quota cycles and date display.
PANEL_TIMEZONE=Asia/Shanghai
# Repository the in-panel updater downloads releases from. Only that repo's
# published releases are accepted, and the archive must match GitHub's SHA-256
# digest for the asset.
PANEL_UPDATE_REPO=CinnieMochi/nft-forward-panel
